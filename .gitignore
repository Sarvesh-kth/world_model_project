.venv/
__pycache__/
*.pyc
.mujoco-osmesa/
MUJOCO_LOG.TXT

# everything the chain and the controllers write stays local (datasets, latents, frames, controller episodes);
# tracked are the packaged models the controllers run with (simulation/models, Git LFS) and the held-out scenes
simulation/data/*
!simulation/data/README.md
!simulation/data/clutter_scenes/
simulation/data/clutter_scenes/*
!simulation/data/clutter_scenes/collection.json
!simulation/data/clutter_scenes/scene_settings.json
!simulation/models/

# the summaries the controllers write stay local; the shared export of the imagined-SAC runs is tracked
results/*
!results/control_release_v1/

# personal notes stay local
*.md
!README.md
!**/README.md
!RESULTS.md
